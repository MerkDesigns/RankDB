{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "RankDB Dev",
  "mainBinaryName": "rankdb-dev",
  "identifier": "com.merkdesigns.rankdb.devapp",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RankDB Dev",
        "width": 1720,
        "height": 960,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false,
        "maximizable": false,
        "backgroundColor": "#06070b"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": false,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
